# Public base URL of the FastAPI backend (NOT a secret).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Shared demo write token (gap-closure D-002). Empty = header omitted.
# PUBLIC when set (baked into client chunks): same value as backend
# DEMO_WRITE_TOKEN. Demo-staging use only, never user authentication.
NEXT_PUBLIC_DEMO_WRITE_TOKEN=
