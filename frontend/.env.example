# Public base URL of the FastAPI backend (NOT a secret).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# R6 (owner-approved): LEAVE EMPTY for public deploys. No
# frontend/backend token matching is required or wanted — any value
# here bakes PUBLIC into browser JS. Protected writes use the
# login-session flow instead. Empty = header omitted (correct).
NEXT_PUBLIC_DEMO_WRITE_TOKEN=
# Deployed frontend origin (NOT a secret). Owner sets at staging so
# openGraph/absolute metadata URLs resolve; empty = relative URLs kept.
NEXT_PUBLIC_SITE_URL=
