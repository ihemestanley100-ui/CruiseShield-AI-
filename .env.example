# Names only — never commit real values. Copy to .env and fill in locally.
MODEL_API_KEY=
META_MODEL_ID=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
# Comma-separated browser origins allowed to call the JSON API (no secrets).
# Local default covers Next.js dev; production sets its deployed origin(s).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared demo write token (gap-closure D-002). Empty = open local demo.
# When set, POST endpoints require it as a credential. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
DEMO_WRITE_TOKEN=
# Phase 5 protected-demo login. Empty = open local demo (default).
# Set SESSION_SECRET to arm login enforcement; DEMO_USERS lists
# name:role:hash entries (roles: investigator, admin; hashes via
# `python -m app.auth hash`). Generate the secret with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# R09-F2: minimum 32 characters when set. A shorter value is a
# misconfiguration: auth fails closed (503 AUTH_MISCONFIGURED) and no
# session can be minted or validated until a strong secret is set.
SESSION_SECRET=
# SEC-ROT: set to the OLD secret during rotation overlap only;
# empty once the TTL window passes.
SESSION_SECRET_PREVIOUS=
# D-1 audit-chain sealing. Empty = unarmed legacy mode (default):
# audit appends stay plaintext and are counted, never sealed. Set =
# new appends are HMAC-sealed; history stays legacy and is counted,
# never retro-sealed. Accepts hex, base64, or a raw 32+ byte value.
# Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
# Minimum 32 bytes of key material when set. A shorter/undecodable
# value is a misconfiguration: the store refuses to construct
# (fail closed) until fixed or unset.
AUDIT_CHAIN_KEY=
# Key id label for sealed records (rotation: point this at the new
# id, move the old key to AUDIT_CHAIN_KEY_PREVIOUS + _ID_PREVIOUS).
AUDIT_CHAIN_KEY_ID=k1
AUDIT_CHAIN_KEY_PREVIOUS=
AUDIT_CHAIN_KEY_ID_PREVIOUS=
DEMO_USERS=
# D-014 user→tenant map: "alice:org_acme,bob:org_beta". Users absent
# from the map resolve to the default tenant (org_primary). Tenant
# slugs: lowercase alnum start, [a-z0-9_-], max 64 chars. Empty =
# single-tenant behavior (current default, unchanged).
USER_TENANTS=
# CS_ENV: development (default) | staging | production. Only
# production changes behavior: the store refuses synthetic
# seeding/reset there (fail-closed). Set production only with a
# persistent DATA_DIR or database provisioned; otherwise boot fails
# loudly instead of serving seed data.
CS_ENV=development
# D-022 MFA: comma-separated roles that must confirm TOTP enrollment
# before their sessions leave pending (recommended: admin). Empty =
# MFA available but not required. Enroll via /api/v1/auth/mfa/enroll.
MFA_REQUIRED_ROLES=
# Phase 6 AI cost controls. Daily cap counts persisted run attempts
# (0 = unlimited); timeout bounds one model call (keep < 35s).
AI_DAILY_CALL_LIMIT=100
AI_TIMEOUT_SECONDS=30
# D-047: per-provider daily ceiling, 0 disables (global cap governs).
AI_PROVIDER_DAILY_LIMIT=0
# Candidate risk-intelligence layer DI-08/DI-09 (app/risk_intel.py).
# Default OFF; only the exact value "true" enables the additive,
# read-only findings endpoints. Never scores, never decides.
RISK_INTELLIGENCE_V2_ENABLED=
# Phase 5.4 backup producer settings (names only — values live in secrets
# stores / Actions secrets, never in this file or version control).
# These 13 names mirror exactly what .github/workflows/backup-*.yml
# consumes (J3-P12: dead AGE_*/ALERT_* placeholders replaced 2026-11-01).
# Semantics: docs/BACKUP_RECOVERY_RUNBOOK.md.
BACKUP_DATABASE_URL=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_PREFIX=
B2_ENDPOINT=
C3_REPO=
C3_TOKEN=
CSBK_RECIPIENT_PUBKEYS=
CSBK_SIGNING_SEED=
CSBK_SIGNING_VERIFY_KEY=
CSBK_RESTORE_PRIVATE_KEY=
BACKUP_ENV=
# v14.0 S04 connector credentials (names only). Values live ONLY in the
# server environment; connections store these NAMES as secret_refs and
# the API reports presence booleans, never values. Unset = the adapter
# honestly reports AWAITING_CREDENTIALS; nothing is contacted.
CS_CONN_BANKING_KEY=
CS_CONN_NIP_CERT=
CS_CONN_POS_KEY=
CS_CONN_MOBILE_SECRET=
CS_CONN_USSD_KEY=
CS_CONN_WEB_SECRET=
CS_CONN_ATM_CERT=
CS_CONN_TRANSFER_KEY=
CS_CONN_AGENT_KEY=
CS_CONN_INSURANCE_KEY=
CS_CONN_MARKETS_KEY=
CS_CONN_DIGITAL_ASSETS_KEY=
CS_CONN_GOV_CERT=
CS_CONN_TRADE_KEY=
CS_CONN_TELECOM_KEY=
# Phase 5 account platform (D-037/D-040). Self-registration and trial
# metering default OFF (exact "1" enables); founder names the owner
# account entitled without subscription (empty = none).
ALLOW_PUBLIC_REGISTRATION=
TRIAL_ENFORCEMENT=
FOUNDER_USER=
# Phase 5J passkeys (D-045). Passkeys default OFF (exact "1"
# enables); RP_ID/RP_ORIGIN must name the real site before use.
PASSKEYS_ENABLED=
RP_ID=
RP_ORIGIN=

# Telecom Identity (TEL-01..TEL-09). Thresholds ship safe defaults;
# provider secrets stay empty until TEL-08 owner authorization.
TELECOM_CONSENT_REQUIRED=
TELECOM_RETENTION_DAYS=90
TELECOM_ACTOR_PER_MIN=30
TELECOM_SUBJECT_PER_DAY=20
CS_CONN_CAMARA_SECRET=
CS_CONN_MTN_KEY=
CS_CONN_HLR_KEY=

# Geointelligence OS (GEO/IDV/ADR/MAP/PRV). Renderer none = schematic.
GEO_ACTOR_PER_MIN=30
GEO_SUBJECT_PER_DAY=20
GEO_RETENTION_DAYS=90
MAP_PROVIDER=none
CS_CONN_IDENTITY_KEY=
CS_CONN_ADDRESS_KEY=
CS_CONN_IPGEO_KEY=
CS_CONN_GEOCODE_KEY=
CS_CONN_LOCATION_SECRET=
